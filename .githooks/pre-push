#!/bin/sh
# Antes de enviar, roda os testes de tudo o que os commits enviados podem quebrar, segundo a
# matriz de rastreabilidade (packages/rastreabilidade). Recusa o push se algum falhar.
#
# Ativado por `pnpm install` (script "prepare": git config core.hooksPath .githooks).
# Emergencia real: `git push --no-verify` — e diga no commit seguinte o que ficou sem testar.

ZERO=0000000000000000000000000000000000000000
raiz=$(git rev-parse --show-toplevel)
falhou=0

while read -r _ref_local sha_local _ref_remota sha_remoto; do
  # Apagar uma branch remota nao envia codigo.
  [ "$sha_local" = "$ZERO" ] && continue

  if [ "$sha_remoto" != "$ZERO" ] && git cat-file -e "$sha_remoto" 2>/dev/null; then
    base=$sha_remoto
  else
    # Branch nova: compara com o ancestral comum da main remota; sem ela, a suite inteira.
    base=$(git merge-base "$sha_local" origin/main 2>/dev/null)
  fi

  if [ -n "$base" ]; then
    node "$raiz/packages/rastreabilidade/src/impacto.ts" --base "$base" --head "$sha_local" || falhou=1
  else
    node "$raiz/packages/rastreabilidade/src/impacto.ts" --tudo || falhou=1
  fi
done

if [ "$falhou" -ne 0 ]; then
  echo ""
  echo "push recusado: ha teste impactado falhando (veja acima)."
  exit 1
fi
