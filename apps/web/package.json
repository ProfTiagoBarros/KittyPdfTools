{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "clean": "rimraf .next out coverage .turbo",
    "test:coverage": "vitest run --coverage",
    "prebuild": "node ../../packages/pdf-core/scripts/copy-pdfjs-assets.mjs public/pdfjs && node scripts/sync-tesseract.mjs",
    "predev": "node ../../packages/pdf-core/scripts/copy-pdfjs-assets.mjs public/pdfjs && node scripts/sync-tesseract.mjs",
    "build:spike": "cross-env PDFKITTY_SPIKE=1 next build",
    "verify:spike-excluded": "node scripts/verify-spike-excluded.mjs",
    "sync:assets": "node ../../packages/pdf-core/scripts/copy-pdfjs-assets.mjs public/pdfjs && node scripts/sync-tesseract.mjs",
    "test:e2e:all": "cross-env PDFKITTY_FIREFOX=1 playwright test",
    "verify:desktop": "node scripts/verify-desktop.mjs",
    "verify:android": "node scripts/verify-android.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@radix-ui/react-slot": "1.3.3",
    "@signpdf/placeholder-plain": "3.3.0",
    "@signpdf/signer-p12": "3.3.0",
    "@signpdf/signpdf": "3.3.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "node-forge": "1.4.0",
    "pdf-core": "workspace:*",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.3",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/node-forge": "1.3.14",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "cross-env": "10.1.0",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "fflate": "^0.8.3",
    "globals": "17.11.0",
    "http-server": "14.1.1",
    "jsdom": "30.0.1",
    "rimraf": "6.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11"
  }
}
