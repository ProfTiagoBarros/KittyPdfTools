# Falhar cedo se o Node local divergir do exigido em engines
engine-strict=true

# Peers resolvidos automaticamente, sem quebrar o install por ranges divergentes
auto-install-peers=true
strict-peer-dependencies=false

# node_modules isolado (padrao pnpm): impede import de dependencia nao declarada,
# o que protege a regra de baixo acoplamento entre pdf-core, web e desktop.
node-linker=isolated
