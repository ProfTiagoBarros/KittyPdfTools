{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["vitest/globals", "node"],
    /*
     * O pacote roda direto no Node, sem compilacao: o Node 24 apaga os tipos ao carregar. Para
     * isso os imports levam a extensao `.ts` e a sintaxe fica restrita ao que pode ser apagado
     * (nada de `enum` ou `namespace`).
     */
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true
  },
  "include": ["src/**/*.ts", "*.config.ts"],
  "exclude": ["node_modules", "coverage"]
}
